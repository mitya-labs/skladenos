+/*
+ * The PHY answers with GoodCRC on its own, using the revision from
+ * MSG_CONFIG. Keep it in sync with the negotiated revision, otherwise a
+ * PD 3.0 partner gets PD 2.0 GoodCRCs after the contract.
+ */
+static void qcom_pmic_typec_pdphy_update_spec_rev(struct pmic_typec_pdphy *pmic_typec_pdphy,
+						  unsigned int rev)
+{
+	unsigned long flags;
+	int ret;
+
+	if (rev == pmic_typec_pdphy->spec_rev)
+		return;
+
+	spin_lock_irqsave(&pmic_typec_pdphy->lock, flags);
+	ret = regmap_update_bits(pmic_typec_pdphy->regmap,
+				 pmic_typec_pdphy->base + USB_PDPHY_MSG_CONFIG_REG,
+				 MSG_CONFIG_SPEC_REV_MASK, rev);
+	spin_unlock_irqrestore(&pmic_typec_pdphy->lock, flags);
+
+	if (!ret)
+		pmic_typec_pdphy->spec_rev = rev;
+
+	dev_dbg(pmic_typec_pdphy->dev, "spec_rev %u: %d\n", rev, ret);
+}
