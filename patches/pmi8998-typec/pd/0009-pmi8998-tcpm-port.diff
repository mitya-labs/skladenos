+#define SR_LOOP_WINDOW_MS	60	/* PS_RDY -> Soft_Reset */
+#define SR_LOOP_MAX		3
+
+/*
+ * Some sources (seen with an Apple Mac) send a message after PS_RDY that
+ * this PHY never receives, so they Soft_Reset ~36 ms after every PS_RDY,
+ * forever: ~12 renegotiations/s, each one a power_supply uevent. After a
+ * few such loops stop doing PD with this partner: no GoodCRC, no TX. Both
+ * sides then fall back to plain Type-C current until the cable is pulled.
+ * Returns true if the message must be dropped.
+ */
+static bool qcom_pmic_typec_pdphy_check_loop(struct pmic_typec_pdphy *pmic_typec_pdphy,
+					     const struct pd_message *msg)
+{
+	unsigned int type = pd_header_type_le(msg->header);
+	bool ctrl = !pd_header_cnt_le(msg->header);
+	unsigned long now = jiffies;
+	unsigned long flags;
+
+	if (pmic_typec_pdphy->pd_blocked)
+		return true;
+
+	if (ctrl && type == PD_CTRL_PS_RDY) {
+		pmic_typec_pdphy->ps_rdy_jiffies = now;
+		return false;
+	}
+
+	if (ctrl && type == PD_CTRL_SOFT_RESET) {
+		if (time_before(now, pmic_typec_pdphy->ps_rdy_jiffies +
+				msecs_to_jiffies(SR_LOOP_WINDOW_MS)) &&
+		    (!pmic_typec_pdphy->sr_loops ||
+		     time_before(now, pmic_typec_pdphy->sr_jiffies + HZ)))
+			pmic_typec_pdphy->sr_loops++;
+		else
+			pmic_typec_pdphy->sr_loops = 0;
+		pmic_typec_pdphy->sr_jiffies = now;
+
+		if (pmic_typec_pdphy->sr_loops < SR_LOOP_MAX)
+			return false;
+
+		spin_lock_irqsave(&pmic_typec_pdphy->lock, flags);
+		pmic_typec_pdphy->pd_blocked = true;
+		regmap_write(pmic_typec_pdphy->regmap,
+			     pmic_typec_pdphy->base + USB_PDPHY_FRAME_FILTER_REG, 0);
+		spin_unlock_irqrestore(&pmic_typec_pdphy->lock, flags);
+
+		dev_warn(pmic_typec_pdphy->dev,
+			 "Soft_Reset loop after PS_RDY, PD off until detach\n");
+		return true;
+	}
+
+	/* Negotiation traffic keeps the count, anything else means PD works */
+	if (!(ctrl && type == PD_CTRL_ACCEPT) &&
+	    !(!ctrl && type == PD_DATA_SOURCE_CAP))
+		pmic_typec_pdphy->sr_loops = 0;
+
+	return false;
+}
+
+static void qcom_pmic_typec_pdphy_cc_detached(struct pmic_typec *tcpm)
+{
+	struct pmic_typec_pdphy *pmic_typec_pdphy = tcpm->pmic_typec_pdphy;
+	unsigned long flags;
+
+	pmic_typec_pdphy->sr_loops = 0;
+	if (!pmic_typec_pdphy->pd_blocked)
+		return;
+
+	spin_lock_irqsave(&pmic_typec_pdphy->lock, flags);
+	pmic_typec_pdphy->pd_blocked = false;
+	regmap_write(pmic_typec_pdphy->regmap,
+		     pmic_typec_pdphy->base + USB_PDPHY_FRAME_FILTER_REG,
+		     FRAME_FILTER_EN_SOP | FRAME_FILTER_EN_HARD_RESET);
+	spin_unlock_irqrestore(&pmic_typec_pdphy->lock, flags);
+
+	dev_info(pmic_typec_pdphy->dev, "partner detached, PD back on\n");
+}
