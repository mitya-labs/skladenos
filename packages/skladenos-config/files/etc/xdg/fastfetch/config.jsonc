// fastfetch для skladenOS: свой логотип и название системы. Свой конфиг пользователя (~/.config/fastfetch/config.jsonc) главнее этого.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/skladenos/fastfetch/logo.txt",
    "color": { "1": "38;2;94;234;219", "2": "38;2;42;167;155", "3": "38;2;63;207;192" },
    "padding": { "right": 2 }
  },
  "display": { "separator": "  ", "key": { "width": 10 }, "color": { "keys": "38;2;94;234;219", "title": "38;2;94;234;219" } },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "OS", "format": "skladenOS (Mobian · Debian)" },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "custom", "key": "WM", "format": "sway (SXMO)" },
    "terminal",
    "cpu",
    "memory",
    "battery",
    "break",
    "colors"
  ]
}
