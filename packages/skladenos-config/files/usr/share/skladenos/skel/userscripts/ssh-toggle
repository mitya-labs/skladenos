#!/bin/sh
# title="SSH сервер: вкл/выкл"
# Переключает sshd (systemd). Если нужен пароль sudo — спросит в терминале.

# в Debian/Mobian юнит называется ssh.service (sshd.service нет); ssh.socket глушим, чтобы он не поднимал sshd обратно
UNIT=ssh.service

if [ "$1" != "--run" ]; then
	# Запускаем в терминале sxmo, чтобы можно было ввести пароль sudo
	exec sxmo_terminal.sh "$0" --run
fi

if systemctl is-active --quiet "$UNIT"; then
	sudo systemctl disable --now ssh.socket "$UNIT" && msg="SSH сервер выключен"
else
	sudo systemctl enable --now "$UNIT" && msg="SSH сервер включён"
fi

[ -z "$msg" ] && msg="Не удалось переключить SSH"
ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{sub(/\/.*/,"",$4); print $4}' | paste -sd' ')"
echo "$msg${ip:+ ($ip)}"
sxmo_notify_user.sh "$msg${ip:+ ($ip)}" 2>/dev/null
sleep 2
