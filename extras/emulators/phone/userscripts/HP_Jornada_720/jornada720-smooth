#!/bin/sh
# title="Jornada 720 (WinCE, pixel-exact scaling with borders)"
export QEMU_SDL_SCALE=integer
# QEMU в тайловом окне sway сначала рисует мелко; sxmo_qemu_resize.sh «пинает» окно (STATE п.111); окно уважает поля под челку и статус-бар
"$HOME/Developer/qemu-jornada720/run.sh" &
RUN=$!
"$HOME/.local/bin/sxmo_qemu_resize.sh" --wait
wait $RUN
